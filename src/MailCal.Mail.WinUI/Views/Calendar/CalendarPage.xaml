<abstract:CalendarPageAbstract
    x:Class="MailCal.Calendar.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:MailCal.Calendar.Views.Abstract"
    xmlns:calendarControls="using:MailCal.Calendar.Controls"
    xmlns:calendarHelpers="using:MailCal.Calendar.Helpers"
    xmlns:controls="using:MailCal.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:MailCal.Calendar.ViewModels.Data"
    xmlns:domain="using:MailCal.Core.Domain"
    xmlns:helpers="using:MailCal.Helpers"
    xmlns:mailCalControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <mailCalControls:CalendarTitleBarContent
            x:Name="CalendarToolbar"
            Grid.Row="0"
            Margin="4,0,7,8" />

        <Border
            Grid.Row="1"
            Margin="4,0,7,7"
            BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="7"
            Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.Readiness.IsBlocked), Mode=OneWay}">
            <!--  Event details popup. Opened next to the tapped event; input passes through to the surface so a second click still opens the event.  -->
            <primitives:FlyoutBase.AttachedFlyout>
                <Flyout x:Name="EventDetailsFlyout" OverlayInputPassThroughElement="{x:Bind CalendarSurface}">
                    <Flyout.FlyoutPresenterStyle>
                        <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="16" />
                            <Setter Property="MaxWidth" Value="420" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>

                    <Grid
                        Width="360"
                        AutomationProperties.AutomationId="CalendarEventDetailsPopup"
                        ColumnSpacing="10"
                        RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Title  -->
                        <Border
                            Width="4"
                            HorizontalAlignment="Center"
                            Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.DisplayDetailsCalendarItemViewModel.AssignedCalendar.BackgroundColorHex), Mode=OneWay, TargetNullValue='LightGray'}"
                            CornerRadius="2" />
                        <TextBlock
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.DisplayDetailsCalendarItemViewModel.Title, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <!--  Date and time  -->
                        <mailCalControls:MailCalFontIcon
                            Grid.Row="1"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Icon="Clock" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{x:Bind calendarHelpers:CalendarXamlHelpers.GetDetailsPopupDateString(ViewModel.DisplayDetailsCalendarItemViewModel, ViewModel.CurrentSettings), Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <!--  Recurrence  -->
                        <mailCalControls:MailCalFontIcon
                            Grid.Row="2"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Icon="CalendarEventRepeat"
                            Visibility="{x:Bind ViewModel.DisplayDetailsCalendarItemViewModel.IsRecurringEvent, Mode=OneWay, FallbackValue=Collapsed}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{x:Bind calendarHelpers:CalendarXamlHelpers.GetDetailsPopupRecurrenceString(ViewModel.DisplayDetailsCalendarItemViewModel, ViewModel.CurrentSettings), Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.DisplayDetailsCalendarItemViewModel.IsRecurringEvent, Mode=OneWay, FallbackValue=Collapsed}" />

                        <!--  Location  -->
                        <mailCalControls:MailCalFontIcon
                            Grid.Row="3"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Icon="Location"
                            Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(ViewModel.DisplayDetailsCalendarItemViewModel.Location), Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DisplayDetailsCalendarItemViewModel.Location, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(ViewModel.DisplayDetailsCalendarItemViewModel.Location), Mode=OneWay}" />

                        <!--  Organizer  -->
                        <mailCalControls:MailCalFontIcon
                            Grid.Row="4"
                            VerticalAlignment="Top"
                            FontSize="16"
                            Icon="Person"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.CalendarEventDetails_Organizer}"
                            Visibility="{x:Bind calendarHelpers:CalendarXamlHelpers.GetOrganizerVisibility(ViewModel.DisplayDetailsCalendarItemViewModel), Mode=OneWay}" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            AutomationProperties.HelpText="{x:Bind domain:Translator.CalendarEventDetails_Organizer}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind calendarHelpers:CalendarXamlHelpers.GetOrganizerText(ViewModel.DisplayDetailsCalendarItemViewModel), Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind calendarHelpers:CalendarXamlHelpers.GetOrganizerVisibility(ViewModel.DisplayDetailsCalendarItemViewModel), Mode=OneWay}" />

                        <!--  Calendar  -->
                        <Ellipse
                            Grid.Row="5"
                            Width="12"
                            Height="12"
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.DisplayDetailsCalendarItemViewModel.AssignedCalendar.BackgroundColorHex), Mode=OneWay, TargetNullValue='LightGray'}" />
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.DisplayDetailsCalendarItemViewModel.AssignedCalendar.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <!--  Actions  -->
                        <StackPanel
                            Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="CalendarEventDetailsPopupJoinButton"
                                Click="EventDetailsJoinOnlineClicked"
                                Visibility="{x:Bind ViewModel.CanJoinOnline, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mailCalControls:MailCalFontIcon FontSize="16" Icon="EventJoinOnline" />
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.CalendarItem_DetailsPopup_JoinOnline}" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="CalendarEventDetailsPopupSeriesButton"
                                Click="EventDetailsViewSeriesClicked"
                                Content="{x:Bind domain:Translator.CalendarItem_DetailsPopup_ViewSeriesButton}"
                                Visibility="{x:Bind ViewModel.CanNavigateSeries, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="CalendarEventDetailsPopupViewButton"
                                Click="EventDetailsViewEventClicked"
                                Content="{x:Bind domain:Translator.CalendarItem_DetailsPopup_ViewEventButton}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Flyout>
            </primitives:FlyoutBase.AttachedFlyout>

            <calendarControls:CalendarPeriodControl
                x:Name="CalendarSurface"
                CalendarItemDropped="CalendarSurfaceCalendarItemDropped"
                CalendarItems="{x:Bind ViewModel.CalendarItems, Mode=OneWay}"
                CalendarSettings="{x:Bind ViewModel.CurrentSettings, Mode=OneWay}"
                DefaultHourBackground="{ThemeResource CalendarDefaultHourBackgroundBrush}"
                EmptySlotTapped="CalendarSurfaceEmptySlotTapped"
                HoverSlotBackground="{ThemeResource CalendarHoverHourBackgroundBrush}"
                IsEnabled="{x:Bind ViewModel.IsCalendarEnabled, Mode=OneWay}"
                RangeSelectionStarted="CalendarSurfaceRangeSelectionStarted"
                SelectedDateTime="{x:Bind ViewModel.SelectedQuickEventDate, Mode=OneWay}"
                SelectedEndDateTime="{x:Bind ViewModel.QuickEventSelectionEnd, Mode=OneWay}"
                SelectedSlotBackground="{ThemeResource CalendarSelectedHourBackgroundBrush}"
                VisibleRange="{x:Bind ViewModel.CurrentVisibleRange, Mode=OneWay}"
                WorkHourBackground="{ThemeResource CalendarWorkHourBackgroundBrush}" />
        </Border>

        <!--  Blocked state. Replaces the time grid while Calendar cannot be used yet.  -->
        <controls:ModeReadinessPanel
            Grid.Row="1"
            AutomationProperties.AutomationId="CalendarModeReadinessPanel"
            ViewModel="{x:Bind ViewModel.Readiness}"
            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.Readiness.IsBlocked), Mode=OneWay}" />

        <Canvas
            x:Name="CalendarOverlayCanvas"
            Grid.RowSpan="2"
            IsHitTestVisible="False">
            <Grid
                x:Name="TeachingTipPositionerGrid"
                Background="Transparent"
                IsHitTestVisible="False"
                Visibility="Visible" />

            <Popup
                x:Name="QuickEventPopupDialog"
                ActualPlacementChanged="PopupPlacementChanged"
                Closed="QuickEventPopupClosed"
                DesiredPlacement="{x:Bind helpers:XamlHelpers.GetPlaccementModeForCalendarType(ViewModel.StatePersistanceService.CalendarDisplayType), Mode=OneWay}"
                IsLightDismissEnabled="True"
                PlacementTarget="{x:Bind TeachingTipPositionerGrid}">
                <Popup.ChildTransitions>
                    <TransitionCollection>
                        <PopupThemeTransition />
                    </TransitionCollection>
                </Popup.ChildTransitions>

                <Grid
                    MinWidth="440"
                    MaxWidth="520"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    BorderBrush="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedQuickEventAccountCalendar.BackgroundColorHex), Mode=OneWay, TargetNullValue='LightGray'}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="CalendarPageButton"
                        Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedQuickEventAccountCalendar.BackgroundColorHex), Mode=OneWay, TargetNullValue='LightGray'}"
                        CornerRadius="8,8,0,0">
                        <Button.Content>
                            <Grid
                                Height="36"
                                Padding="12,0"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind helpers:XamlHelpers.GetReadableTextColor(ViewModel.SelectedQuickEventAccountCalendar.BackgroundColorHex), Mode=OneWay}"
                                    Text="{x:Bind ViewModel.SelectedQuickEventAccountCalendar.Account.Name, Mode=OneWay}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind helpers:XamlHelpers.GetReadableTextColor(ViewModel.SelectedQuickEventAccountCalendar.BackgroundColorHex), Mode=OneWay}"
                                    Text="{x:Bind ViewModel.SelectedQuickEventAccountCalendarName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />

                                <mailCalControls:MailCalFontIcon
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{x:Bind helpers:XamlHelpers.GetReadableTextColor(ViewModel.SelectedQuickEventAccountCalendar.BackgroundColorHex), Mode=OneWay}"
                                    Icon="ChevronDown" />
                            </Grid>
                        </Button.Content>
                        <Button.Flyout>
                            <Flyout x:Name="QuickEventAccountSelectorFlyout" Placement="Bottom">
                                <ListView
                                    MaxHeight="300"
                                    AutomationProperties.AutomationId="CalendarPageListView"
                                    ItemsSource="{x:Bind ViewModel.AccountCalendarStateService.GroupedAccountCalendars, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="data:GroupedAccountCalendarViewModel">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    Margin="8,4,8,0"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Account.Name, Mode=OneWay}" />
                                                <ListView
                                                    AutomationProperties.AutomationId="CalendarPageQuickEventCalendarList"
                                                    IsItemClickEnabled="True"
                                                    ItemClick="QuickEventAccountSelectorItemClicked"
                                                    ItemsSource="{x:Bind AccountCalendars, Mode=OneWay}"
                                                    SelectionMode="None">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="data:AccountCalendarViewModel">
                                                            <StackPanel
                                                                Margin="0,0,16,0"
                                                                Orientation="Horizontal"
                                                                Spacing="8">
                                                                <Ellipse
                                                                    Width="14"
                                                                    Height="14"
                                                                    Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(BackgroundColorHex), Mode=OneWay}" />
                                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Grid
                        Grid.Row="1"
                        Padding="12"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                AutomationProperties.AutomationId="CalendarPageTextBox"
                                FontSize="16"
                                PlaceholderText="{x:Bind domain:Translator.QuickEventDialog_EventName}"
                                Text="{x:Bind ViewModel.EventName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CalendarPageCheckBox"
                                Content="{x:Bind domain:Translator.QuickEventDialog_IsAllDay}"
                                IsChecked="{x:Bind ViewModel.IsAllDay, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock
                                AutomationProperties.AutomationId="CalendarQuickEventDateRange"
                                Text="{x:Bind ViewModel.QuickEventDateRangeText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    AutomationProperties.AutomationId="CalendarPageComboBox"
                                    IsEditable="True"
                                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsAllDay), Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.HourSelectionStrings, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedStartTimeString, Mode=TwoWay}"
                                    TextSubmitted="StartTimeDurationSubmitted" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="-" />

                                <ComboBox
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="CalendarPageComboBox2"
                                    IsEditable="True"
                                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsAllDay), Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.HourSelectionStrings, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedEndTimeString, Mode=TwoWay}"
                                    TextSubmitted="EndTimeDurationSubmitted" />
                            </Grid>

                        </StackPanel>
                        <TextBox
                            Grid.Row="2"
                            AutomationProperties.AutomationId="CalendarPageTextBox2"
                            PlaceholderText="{x:Bind domain:Translator.QuickEventDialog_Location}"
                            Text="{x:Bind ViewModel.Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CalendarPageButton2"
                                Click="MoreDetailsClicked"
                                Content="{x:Bind domain:Translator.QuickEventDialogMoreDetailsButtonText}" />

                            <Button
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CalendarPageButton3"
                                Click="SaveQuickEventClicked"
                                Content="{x:Bind domain:Translator.Buttons_Save}"
                                IsEnabled="{x:Bind ViewModel.CanSaveQuickEvent, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Popup>
        </Canvas>
    </Grid>
</abstract:CalendarPageAbstract>
